{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "default"
      },
      "node": "22.16.0"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false"
      },
      "ios": {
        "resourceClass": "default",
        "cache": {
          "paths": ["ios/Pods"]
        }
      },
      "android": {
        "buildType": "apk"
      },
      "node": "22.16.0"
    },
    "production": {
      "channel": "production",
      "ios": {
        "resourceClass": "default"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
