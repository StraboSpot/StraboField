# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

project 'StraboSpot2.xcodeproj'

source 'https://github.com/CocoaPods/Specs.git'

MIN_IOS_OVERRIDE = '15.5'
if Gem::Version.new(MIN_IOS_OVERRIDE) > Gem::Version.new(min_ios_version_supported)
      min_ios_version_supported = MIN_IOS_OVERRIDE
end
# existing code
platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions setup (permission handlers compiled into the RNPermissions pod)
require_relative '../node_modules/react-native-permissions/scripts/setup'
setup_permissions([
  'Camera',
  'LocationWhenInUse',
])

$RNMapboxMapsImpl = 'mapbox'

# SentryCrash decodes saved crash reports with KeepPartialObject, so a half-written report can
# decode to an NSArray. -doctorReport: then calls report[@"crash"] and throws during Sentry
# startup, on every launch, because the report is never deleted. Discard non-dictionary reports.
# Upstream (sentry-cocoa main) has the same code; remove this once it's fixed there.
def patch_sentry_corrupt_report_crash
  path = File.join(__dir__, 'Pods/Sentry/Sources/SentryCrash/Recording/SentryCrash.m')
  marker = '// StraboSpot patch: discard non-dictionary crash reports'
  anchor = [
    '    if (crashReport == nil) {',
    '        SENTRY_LOG_ERROR(@"Could not load crash report");',
    '        return nil;',
    '    }',
  ].join("\n")
  guard = [
    "    #{marker}",
    '    if (![crashReport isKindOfClass:[NSDictionary class]]) {',
    '        SENTRY_LOG_ERROR(@"Crash report %" PRIx64 " is not a dictionary, deleting it", reportID);',
    '        sentrycrash_deleteReportWithID(reportID);',
    '        return nil;',
    '    }',
  ].join("\n")
  source = File.read(path)
  return if source.include?(marker)
  raise "Sentry patch anchor not found in #{path}; update patch_sentry_corrupt_report_crash in the Podfile" unless source.include?(anchor)
  File.chmod(0644, path)
  File.write(path, source.sub(anchor, "#{anchor}\n\n#{guard}"))
  Pod::UI.puts 'Patched SentryCrash.m to discard non-dictionary crash reports'.green
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => :static
end

target 'StraboSpot2' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

 pod 'IQKeyboardManagerSwift', :git => 'https://github.com/douglasjunior/IQKeyboardManager.git', :branch => 'react-native-keyboard-manager'

  post_install do |installer|
     bitcode_strip_path = `xcrun --find bitcode_strip`.chop!

      def strip_bitcode_from_framework(bitcode_strip_path, framework_relative_path)
        framework_path = File.join(Dir.pwd, framework_relative_path)
        command = "#{bitcode_strip_path} #{framework_path} -r -o #{framework_path}"
        puts "Stripping bitcode: #{command}"
        system(command)
      end

      framework_paths = [
        "Pods/MapboxCommon/MapboxCommon.xcframework/ios-arm64/MapboxCommon.framework/MapboxCommon",
        "Pods/MapboxMobileEvents/MapboxMobileEvents.xcframework/ios-arm64_armv7/MapboxMobileEvents.framework/MapboxMobileEvents",
        "Pods/MapboxCoreMaps/MapboxCoreMaps.xcframework/ios-arm64/MapboxCoreMaps.framework/MapboxCoreMaps",
      ]

      framework_paths.each do |framework_relative_path|
        strip_bitcode_from_framework(bitcode_strip_path, framework_relative_path)
      end
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    #__apply_Xcode_14_3_RC_post_install_workaround(installer)
    $RNMapboxMaps.post_install(installer)
    patch_sentry_corrupt_report_crash
#       installer.generated_projects.each do |project|
#         project.targets.each do |target|
#             target.build_configurations.each do |config|
#                 config.build_settings["DEVELOPMENT_TEAM"] = "The University of Kansas"
#             end
#         end
   installer.pods_project.targets.each do |target|
    # Some pods (lottie-ios, AsyncStorage, ...) declare targets below Xcode's supported minimum
    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target && Gem::Version.new(deployment_target) < Gem::Version.new(min_ios_version_supported)
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
      end
    end
    if target.respond_to?(:product_type) and target.product_type == "com.apple.product-type.bundle"
      target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
      end
  end


pre_install do |installer|
  fix_mapbox_events(installer)
end

pre_install do |installer|
    $RNMapboxMaps.pre_install(installer)
  end
end
