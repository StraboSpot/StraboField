{
  "metadata": {
    "appVersion": "2.23.2",
    "schemaVersion": "1.0",
    "lastUpdated": "2025-10-24",
    "currentBranch": "master",
    "description": "Complete schema for all possible fields in Project, Dataset, and Spot objects"
  },
  "projectSchema": {
    "type": "object",
    "description": "Project object structure",
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique project identifier (UUID)",
        "required": true
      },
      "date": {
        "type": "string",
        "format": "iso-datetime",
        "description": "ISO datetime when project created",
        "required": true
      },
      "modified_timestamp": {
        "type": "number",
        "description": "Unix timestamp of last modification",
        "required": true
      },
      "description": {
        "type": "object",
        "description": "Project metadata",
        "properties": {
          "project_name": {
            "type": "string",
            "description": "Project name",
            "required": true
          },
          "start_date": {
            "type": "string",
            "format": "iso-date",
            "description": "Project start date"
          },
          "end_date": {
            "type": "string",
            "format": "iso-date",
            "description": "Project end date (must be >= start_date)"
          },
          "notes": {
            "type": "string",
            "description": "Multiline project notes"
          },
          "instruments": {
            "type": "string",
            "description": "GPS/measurement instruments used"
          },
          "gps_datum": {
            "type": "string",
            "description": "GPS datum",
            "default": "WGS84 (Default)"
          },
          "magnetic_declination": {
            "type": "number",
            "description": "Magnetic declination in degrees",
            "default": 0,
            "minimum": -180,
            "maximum": 180
          },
          "orcid": {
            "type": "string",
            "description": "Researcher ORCID identifier"
          },
          "other_team_members": {
            "type": "string",
            "description": "Team member names"
          },
          "area_of_interest": {
            "type": "string",
            "description": "Geographic area description"
          },
          "purpose_of_study": {
            "type": "string",
            "description": "Study purpose/objectives"
          },
          "grant_id": {
            "type": "string",
            "description": "Grant identifier"
          },
          "funding_agency": {
            "type": "string",
            "description": "Funding organization"
          }
        }
      },
      "other_features": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Array of geologic feature types",
        "default": [
          "geomorphic",
          "hydrologic",
          "paleontological",
          "igneous",
          "metamorphic",
          "sedimentological",
          "other"
        ]
      },
      "relationship_types": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Array of relationship type definitions",
        "default": [
          "cross-cuts",
          "mutually cross-cuts",
          "is cut by",
          "is younger than",
          "is older than",
          "is lower metamorphic grade than",
          "is higher metamorphic grade than",
          "is included within",
          "includes",
          "merges with"
        ]
      },
      "templates": {
        "type": "object",
        "description": "Templates configuration",
        "properties": {
          "measurementTemplates": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Array of measurement template definitions"
          },
          "activeMeasurementTemplates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Currently active measurement templates"
          },
          "useMeasurementTemplates": {
            "type": "boolean",
            "description": "Enable/disable measurement templates"
          }
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "templates": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "active": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "isInUse": {
              "type": "boolean"
            }
          }
        }
      },
      "useContinuousTagging": {
        "type": "boolean",
        "description": "Continuous tagging setting",
        "default": false
      },
      "tags": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/tag"
        },
        "description": "Array of project tags"
      },
      "reports": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/report"
        },
        "description": "Array of project reports"
      }
    }
  },
  "datasetSchema": {
    "type": "object",
    "description": "Dataset object structure",
    "properties": {
      "id": {
        "type": [
          "string",
          "number"
        ],
        "description": "Unique identifier for the dataset",
        "required": true
      },
      "name": {
        "type": "string",
        "description": "Display name",
        "required": true,
        "default": "Default"
      },
      "date": {
        "type": "string",
        "format": "iso-datetime",
        "description": "ISO 8601 timestamp when created",
        "required": true
      },
      "modified_timestamp": {
        "type": "number",
        "description": "Last modification time (Unix timestamp in ms)",
        "required": true
      },
      "spotIds": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "number"
          ]
        },
        "description": "Array of spot IDs in this dataset",
        "required": true,
        "default": []
      },
      "images": {
        "type": "object",
        "description": "Image management (mobile)",
        "required": true,
        "properties": {
          "imageIds": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            },
            "description": "Array of downloaded image IDs",
            "default": []
          },
          "neededImagesIds": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            },
            "description": "Array of image IDs that need download",
            "default": []
          }
        }
      }
    },
    "notes": [
      "spotIds and images fields are removed when uploading to server",
      "Datasets are stored in Redux state keyed by id",
      "Multiple datasets can be active simultaneously",
      "Datasets can be marked as read-only"
    ]
  },
  "spotSchema": {
    "type": "object",
    "description": "Spot GeoJSON Feature structure",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "Feature"
        ],
        "required": true
      },
      "geometry": {
        "type": "object",
        "description": "GeoJSON Geometry",
        "required": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Point",
              "MultiPoint",
              "LineString",
              "MultiLineString",
              "Polygon",
              "MultiPolygon",
              "GeometryCollection"
            ],
            "required": true
          },
          "coordinates": {
            "description": "GeoJSON coordinates (structure varies by geometry type)",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Point coordinates [lng, lat] or [lng, lat, altitude]"
              },
              {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "description": "LineString or MultiPoint coordinates"
              },
              {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "description": "Polygon or MultiLineString coordinates"
              }
            ]
          }
        }
      },
      "properties": {
        "$ref": "#/definitions/spotProperties"
      }
    }
  },
  "definitions": {
    "tag": {
      "type": "object",
      "description": "Tag object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tag ID (UUID)",
          "required": true
        },
        "type": {
          "type": "string",
          "enum": [
            "geologic_unit",
            "concept",
            "documentation",
            "rosetta",
            "experimental_apparatus",
            "other"
          ],
          "description": "Tag type",
          "required": true
        },
        "name": {
          "type": "string",
          "description": "Tag name",
          "required": true
        },
        "spots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of spot IDs tagged"
        },
        "features": {
          "type": "object",
          "description": "Feature-level tagging",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of feature IDs for each spot"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "description": "Report object",
      "properties": {
        "id": {
          "type": "string",
          "description": "UUID",
          "required": true
        },
        "name": {
          "type": "string",
          "description": "Report name",
          "required": true
        },
        "description": {
          "type": "string",
          "description": "Report description"
        },
        "created_timestamp": {
          "type": "number",
          "description": "Unix timestamp"
        },
        "updated_timestamp": {
          "type": "number",
          "description": "Unix timestamp"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Array of image objects"
        },
        "spots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of spot IDs in report"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of tag IDs in report"
        }
      }
    },
    "spotProperties": {
      "type": "object",
      "description": "Spot properties (all custom fields)",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique spot identifier",
          "required": true
        },
        "name": {
          "type": "string",
          "description": "Spot name/label",
          "required": true
        },
        "date": {
          "type": "string",
          "format": "iso-date",
          "description": "ISO string date (creation)",
          "required": true
        },
        "time": {
          "type": "string",
          "format": "iso-time",
          "description": "ISO string time",
          "required": true
        },
        "modified_timestamp": {
          "type": "number",
          "description": "Unix timestamp",
          "required": true
        },
        "lat": {
          "type": "number",
          "description": "Latitude (WGS84)",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "description": "Longitude (WGS84)",
          "minimum": -180,
          "maximum": 180
        },
        "altitude": {
          "type": "number",
          "description": "Altitude in meters"
        },
        "gps_accuracy": {
          "type": "number",
          "description": "GPS accuracy in meters"
        },
        "spot_radius": {
          "type": "number",
          "description": "Spot radius in meters"
        },
        "notes": {
          "type": "string",
          "description": "Spot notes (multiline)"
        },
        "notesTimestamp": {
          "type": "string",
          "description": "Timestamp of notes (JS Date Object)"
        },
        "image_basemap": {
          "type": "number",
          "description": "ID of parent image basemap"
        },
        "strat_section_id": {
          "type": "string",
          "description": "UUID of parent stratigraphic section"
        },
        "nesting": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Array of nested spot IDs"
        },
        "data": {
          "type": "object",
          "properties": {
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of external URLs"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of links"
            }
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sample"
          },
          "description": "Array of sample objects"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/image"
          },
          "description": "Array of image objects"
        },
        "orientation_data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/orientation"
          },
          "description": "Array of orientation measurements"
        },
        "sed": {
          "$ref": "#/definitions/sedimentology"
        },
        "pet": {
          "$ref": "#/definitions/petrology"
        },
        "_3d_structures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/threeDStructure"
          },
          "description": "Faults, folds, fabrics, tensors"
        },
        "fabrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fabric"
          },
          "description": "Fabric data"
        },
        "tephra": {
          "$ref": "#/definitions/tephra"
        },
        "geologic_unit": {
          "type": "object",
          "description": "Geologic unit designation"
        },
        "earthquakes": {
          "type": "object",
          "description": "Earthquake/seismic data"
        },
        "trace": {
          "$ref": "#/definitions/trace"
        },
        "surface_feature": {
          "$ref": "#/definitions/surfaceFeature"
        },
        "site_safety": {
          "type": "object",
          "description": "Safety information"
        },
        "report": {
          "type": "object",
          "description": "Report data"
        }
      }
    },
    "sample": {
      "type": "object",
      "description": "Sample object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Sample ID"
        },
        "label": {
          "type": "string",
          "description": "Sample label"
        },
        "sample_id_name": {
          "type": "string",
          "description": "Sample ID name"
        },
        "sample_type": {
          "type": "string",
          "enum": [
            "core",
            "ctd",
            "cuttings",
            "dredge",
            "grab",
            "hole",
            "individual_sample",
            "oriented_core",
            "rock_powder",
            "site",
            "terrestrial_section",
            "trawl",
            "other"
          ],
          "description": "Sample type"
        },
        "Sample_IGSN": {
          "type": "string",
          "description": "International Generic Sample Number"
        },
        "main_sampling_purpose": {
          "type": "string",
          "description": "Main sampling purpose (fabric, petrology, geochronology, etc.)"
        },
        "material_type": {
          "type": "string",
          "enum": [
            "intact_rock",
            "fragmented_rock",
            "sediment",
            "tephra",
            "carbon_or_animal",
            "other"
          ],
          "description": "Material type"
        },
        "inplaceness_of_sample": {
          "type": "number",
          "description": "1 (float) to 5 (definitely in place)",
          "minimum": 1,
          "maximum": 5
        },
        "oriented_sample": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ],
          "description": "Whether sample is oriented"
        },
        "sample_size": {
          "type": "string",
          "description": "Size description"
        },
        "degree_of_weathering": {
          "type": "number",
          "description": "1 (highly weathered) to 5 (fresh)",
          "minimum": 1,
          "maximum": 5
        },
        "sample_notes": {
          "type": "string",
          "description": "Notes about sample"
        },
        "user_code": {
          "type": "string",
          "description": "SESAR user code"
        },
        "collector": {
          "type": "string",
          "description": "Sample collector"
        },
        "igsn": {
          "type": "string",
          "description": "IGSN"
        },
        "longitude": {
          "type": "number",
          "description": "Sample longitude"
        },
        "latitude": {
          "type": "number",
          "description": "Sample latitude"
        },
        "longitude_end": {
          "type": "number",
          "description": "End longitude (optional, for line samples)"
        },
        "latitude_end": {
          "type": "number",
          "description": "End latitude (optional, for line samples)"
        },
        "collection_start_date": {
          "type": "string",
          "format": "iso-date",
          "description": "Collection start date"
        },
        "purpose": {
          "type": "string",
          "description": "Sampling purpose"
        },
        "description": {
          "type": "string",
          "description": "Sample description"
        },
        "material": {
          "type": "string",
          "description": "Material description"
        }
      }
    },
    "image": {
      "type": "object",
      "description": "Image object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Image ID"
        },
        "title": {
          "type": "string",
          "description": "Image name/title"
        },
        "image_type": {
          "type": "string",
          "enum": [
            "photo",
            "sketch",
            "screenshot",
            "thin_section",
            "geological_cross_section",
            "geophysical_cross_section",
            "stratigraphic_section",
            "other"
          ],
          "description": "Image type"
        },
        "caption": {
          "type": "string",
          "description": "Image description"
        },
        "image_source": {
          "type": "string",
          "description": "Source reference"
        },
        "scale_of_image": {
          "type": "string",
          "description": "Overall scale"
        },
        "scale_of_object": {
          "type": "string",
          "description": "Scale in meters"
        },
        "width_of_image_view": {
          "type": "number",
          "description": "Width dimension"
        },
        "units_of_image_view": {
          "type": "string",
          "enum": [
            "km",
            "m",
            "cm",
            "mm",
            "um"
          ],
          "description": "Units of measurement"
        },
        "view_azimuth_trend": {
          "type": "number",
          "description": "View azimuth (0-360 degrees)",
          "minimum": 0,
          "maximum": 360
        },
        "view_angle_plunge": {
          "type": "number",
          "description": "View angle plunge (-90 to 90 degrees)",
          "minimum": -90,
          "maximum": 90
        },
        "orientation_of_view_subject": {
          "type": "string",
          "description": "Description of view orientation"
        },
        "annotated": {
          "type": "boolean",
          "description": "Has annotations"
        }
      }
    },
    "orientation": {
      "type": "object",
      "description": "Orientation/Measurement object",
      "properties": {
        "id": {
          "type": "string",
          "description": "UUID"
        },
        "type": {
          "type": "string",
          "enum": [
            "planar_orientation",
            "linear_orientation",
            "tabular_orientation"
          ],
          "description": "Measurement type"
        },
        "label": {
          "type": "string",
          "description": "Measurement label"
        },
        "strike": {
          "type": "number",
          "description": "Strike (0-360 degrees)",
          "minimum": 0,
          "maximum": 360
        },
        "dip_direction": {
          "type": "number",
          "description": "Dip direction azimuth (0-360 degrees)",
          "minimum": 0,
          "maximum": 360
        },
        "dip": {
          "type": "number",
          "description": "Dip angle (0-90 degrees)",
          "minimum": 0,
          "maximum": 90
        },
        "trend": {
          "type": "number",
          "description": "Trend azimuth (0-360 degrees)",
          "minimum": 0,
          "maximum": 360
        },
        "plunge": {
          "type": "number",
          "description": "Plunge angle (0-90 degrees)",
          "minimum": 0,
          "maximum": 90
        },
        "rake": {
          "type": "number",
          "description": "Rake angle (0-180 degrees)",
          "minimum": 0,
          "maximum": 180
        },
        "quality": {
          "type": "string",
          "description": "Measurement quality"
        },
        "feature_type": {
          "type": "string",
          "description": "Type of feature measured"
        },
        "bedding_type": {
          "type": "string",
          "description": "Bedding type"
        },
        "contact_type": {
          "type": "string",
          "description": "Contact type"
        },
        "facing_direction": {
          "type": "string",
          "description": "Facing direction"
        }
      }
    },
    "sedimentology": {
      "type": "object",
      "description": "Sedimentology data",
      "properties": {
        "bedding": {
          "type": "object",
          "description": "Bedding data"
        },
        "lithologies": {
          "type": "object",
          "description": "Lithology composition"
        },
        "structures": {
          "type": "object",
          "description": "Sedimentary structures"
        },
        "interpretations": {
          "type": "object",
          "description": "Environmental interpretations"
        },
        "fossils": {
          "type": "object",
          "description": "Fossil data"
        },
        "diagenesis": {
          "type": "object",
          "description": "Diagenetic features"
        },
        "strat_section": {
          "type": "object",
          "description": "Stratigraphic section settings"
        },
        "interval": {
          "type": "object",
          "description": "Stratigraphic interval"
        }
      }
    },
    "petrology": {
      "type": "object",
      "description": "Petrology data",
      "properties": {
        "igneous": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Igneous rock data"
        },
        "metamorphic": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Metamorphic rock data"
        },
        "alteration_or": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Alteration/ore data"
        },
        "fault": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Fault rock data"
        },
        "minerals": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Mineral data"
        },
        "reactions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Reaction textures"
        }
      }
    },
    "threeDStructure": {
      "type": "object",
      "description": "3D Structure object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Structure ID"
        },
        "type": {
          "type": "string",
          "enum": [
            "fault",
            "fold",
            "fabric",
            "tensor",
            "other"
          ],
          "description": "Structure type"
        },
        "label": {
          "type": "string",
          "description": "Structure label"
        },
        "fault_type": {
          "type": "string",
          "description": "Fault type"
        },
        "fault_movement_type": {
          "type": "string",
          "description": "Fault movement type"
        },
        "fault_displacement": {
          "type": "number",
          "description": "Fault displacement"
        },
        "slip_sense": {
          "type": "string",
          "description": "Slip sense"
        },
        "fold_type": {
          "type": "string",
          "description": "Fold type"
        },
