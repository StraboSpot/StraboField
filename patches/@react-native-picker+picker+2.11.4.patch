 RCT_NOT_IMPLEMENTED(- (instancetype)initWithCoder:(NSCoder *)aDecoder)
 
+// Fabric sets every prop on every render. Reloading the rows each time frees the cells a touch in flight is still
+// hit-testing (EXC_BAD_ACCESS in UIPickerColumnView _allVisibleCells), so reload only when something changed.
 - (void)setItems:(NSArray<NSDictionary *> *)items
 {
+  if ([_items isEqualToArray:items]) return;
   _items = [items copy];
+  [self reloadAllComponents];
   [self setNeedsLayout];
 }
 
