 RCT_EXPORT_MODULE(ImagePicker)
 
+// patch: guard against invoking the JS callback more than once. On the New
+// Architecture a JSI callback is single-use; a second invocation aborts the
+// process (SIGABRT via google::logging_fail / convertJSIFunctionToCallback).
+// A single cancel/dismiss can fire two delegate callbacks (e.g.
+// imagePickerControllerDidCancel + presentationControllerDidDismiss on iPad
+// swipe-to-dismiss), so every callback invocation is routed through here and
+// the block is cleared after the first call.
+- (void)rnip_invokeCallback:(NSArray *)args
+{
+    RCTResponseSenderBlock cb = self.callback;
+    if (cb == nil) {
+        return;
+    }
+    self.callback = nil;
+    cb(args);
+}
